# Copy to `.env` (git-ignored) and adjust. Never commit real secrets. An empty value means "unset".

# Runtime mode for the API: development | test | production
NODE_ENV=development

# Port the API listens on. The web dev server (5175) proxies /api to this port.
PORT=3002

# Postgres connection string for local development (matches docker-compose.yml, host port 5434).
# In production it is the Neon connection string; a local host is refused there.
DATABASE_URL=postgres://arabic:arabic@localhost:5434/arabic

# Separate database for integration tests, created by docker/postgres/init-test-db.sql.
# Tests delete rows freely, so it must never point at the development database.
DATABASE_URL_TEST=postgres://arabic:arabic@localhost:5434/arabic_test

# Browser origin of the web app. The API uses it for the Origin check (CSRF). In production it must
# be the https URL of the deployed web app, or the API refuses to boot.
WEB_ORIGIN=http://localhost:5175

# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Rate limiting. General limit per IP and window; the stricter limit applies to login/register
# (per IP + email) over its own window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# AI -------------------------------------------------------------------------------------------
# Which adapter answers: fake | gemini. Unset: `gemini` when GEMINI_API_KEY is set, else `fake`
# (development), and always `fake` under NODE_ENV=test so no test can hit a paid API. Production
# refuses `fake`.
AI_PROVIDER=

# Google AI Studio key for the Gemini adapter (free tier). Server only: it never reaches the browser.
# Required in production while AI_ENABLED=true; required wherever AI_PROVIDER=gemini.
GEMINI_API_KEY=

# free | paid. On `free` Google may train on prompts, so only made-up chats may go through it:
# production refuses INVITES_ENABLED=true while this is `free`.
AI_TIER=free

# Kill switch. false: every AI call answers AI_DISABLED and the provider is never contacted.
AI_ENABLED=true

# Model per purpose (so a cheaper model can answer the simple calls).
AI_MODEL_CORRECTION=gemini-2.5-flash
AI_MODEL_REPLY=gemini-2.5-flash
AI_MODEL_GLOSS=gemini-2.5-flash-lite

# Daily caps, counted from the ai_calls table: turns per signed-in learner, turns per guest, and
# provider calls across everyone.
AI_DAILY_TURNS_LEARNER=60
AI_DAILY_TURNS_GUEST=20
AI_DAILY_CALLS_GLOBAL=400

# Hard monthly spend ceiling in US dollars, summed from ai_calls. 0 means "no paid spend allowed",
# so AI_TIER=paid refuses to boot while this is 0.
AI_MONTHLY_BUDGET_USD=0

# Accounts -------------------------------------------------------------------------------------
# Invite sign-up for real students. Refused in production while AI_TIER=free (see above).
INVITES_ENABLED=false

# Password of the local dev teacher login that `pnpm db:seed` creates (teacher@arabic-practice.test).
# Local only: in production the seed refuses to create it. Empty uses the documented default
# (Teacher-demo-1!).
SEED_TEACHER_PASSWORD=
